////////////////////////////////////////// PLAYER METRICS struct /////////////////////////////////////////

int function InitializePlayerMetricsStructForPlayer( entity player, string playerID = "" )
{
	bool byID = false

	if( !IsValid( player ) )
	{
		if ( empty( playerID ) )
			return -1
		else
			byID = true
	}
	else
	{
		playerID = player.GetPlatformUID()
		if( playerID == "" )
			return -1
	}

	if ( Tracker_IsPlayerMetricsInitialized( playerID ) )
	{
		#if DEVELOPER
			sqerror( "Metrics already initialized for player: "
			+ ( byID ? playerID : player.GetPlayerName() ) + "\n\n"
			+ FUNC_NAME(2) + "()\n\n" )
			DumpStack()
		#endif

		return GetPlayerMetricsIndexByUID( playerID )
	}

	string ID = playerID
	string name = byID ? "" : player.GetPlayerName()

	PlayerMetrics NewMetrics;

	NewMetrics.playerID = ID
	NewMetrics.playername = name
	NewMetrics.ent = player
	NewMetrics.playerHandle = byID ? -1 : player.GetEncodedEHandle()
    NewMetrics.JumpTimestamps = []
    NewMetrics.WeaponShotsTimestamps = {}
	NewMetrics.SuperglideTimestamps = []
	NewMetrics.kills = 0
	NewMetrics.deaths = 0
	NewMetrics.damage = 0.0
	NewMetrics.shots = 0
	NewMetrics.hits = 0
	NewMetrics.lock1v1Deaths = 0
	NewMetrics.lock1v1Kills = 0
	NewMetrics.lock1v1Damage = 0.0
	NewMetrics.hadleft = false
	NewMetrics.playerleft = false
	NewMetrics.ignore_sync_flag = false
	NewMetrics.previous_champion = false
	NewMetrics.previous_score = 0
	NewMetrics.isValid = true

	SDK_WriteRuntimeBreadcrumb( "tracker_metrics_init", format( "uid=%s name=%s byID=%s len=%d", ID, name, byID ? "true" : "false", file.PlayerMetricsArray.len() ) )

	file.PlayerMetricsArray.append( NewMetrics )
	return PlayerMap_Insert( ID )
}

