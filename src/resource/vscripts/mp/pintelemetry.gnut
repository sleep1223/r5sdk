//make sure round_end isn't started from multiple sources in codebase at same time.
bool process_end_round_complete = true

void function PIN_RoundEnd( int roundnum )
{
	if( process_end_round_complete == true )
	{
		__executeEventEnd_messages()
		thread FinishGameStatsRound()
	}
}

void function __UpdateLiveStats_internal( SerializedData metrics )
{
	if( Tracker_GetQueryBool( "verified" ) && !empty( metrics ) )
		TrackerUpdateLiveStats__internal( metrics )
}

void function FinishGameStatsRound()
{
	if( process_end_round_complete == true )
	{
		process_end_round_complete = false

		if ( file.bTrackerEnabled && TrackerIsLogging__internal() )
		{
			if( !file.bSafeLog )
			{
				TrackerStopLogging__internal( false )
				return
			}

			#if LOG_ERRORS
				DEV_WriteAllTrackerErrors()
			#endif

			TrackerLogEvent__internal
			(
				format( "#|Season: %d\n|| Game ended at %d\n\n%s\n%s", Tracker_GetQueryInt( "season" ), GetUnixTimestamp(), Tracker_BuildAllPlayerMetrics( true ), GetShipWeaponVarData() ),
				file.bTrackerEncryption
			)

			if( !Logging_ShipStats() )
				sqprint( "Shipping to stats server DISABLED -- check playlists file to enable --" )

			if( !Flag( "SurvivalCommentary_FirstBloodReached" ) && !file.bShouldShip && !file.bLiveMetricsOnlyForNonCombatMode )
			{
				sqprint( "No stats to ship...\n" )
				TrackerStopLogging__internal( false )

				if( file.bForceUpdatePlayerData )
					__UpdateMetricsNow()
			}
			else if( file.bLiveMetricsOnlyForNonCombatMode )
			{
				TrackerStopLogging__internal( false )
				if( Logging_ShipStats() )
					__UpdateMetricsNow()
			}
			else
			{
				bool ship = !file.bStatsShipped && Logging_ShipStats()
				TrackerStopLogging__internal( ship ) //IMPORTANT

				//update live global stats for match making (verified only)
				if( ship )//test
					__UpdateMetricsNow()

				//send to discord:
				if( DiscordHook_MatchesRecapEnabled() )
					__EndOfMatch( Tracker_WinnerByKillsAndDamage() )

				if( Logging_ShipStats() )
				{
					foreach( player in GetPlayerArray() )
					{
						if( !IsValid( player ) )
							continue

						LocalMsg( player, "#FS_STATS_SHIPPED", "#FS_STATS_SHIPPED_MSG", eMsgUI.DEFAULT, 4 )
					}
				}
			}
		}

		UpdateRoundStats_GlobalsCarryOver()
		__DestroyStats()
		process_end_round_complete = true
		file.PIN_GameState_Start = false
	}
}

void function __UpdateMetricsNow()
{
	if( file.bStatsShipped )
	{
		printw( "Tried to ship stats more than once." )
		return
	}

	file.bStatsShipped = true
	__UpdateLiveStats_internal( Tracker_BuildAllPlayerMetrics( true ) )
}

const float MIN_INTERVAL_BACKEND_UPDATES = 45.0
void function __UpdateMetricsAtInterval( float updateInterval )
{
	mAssert( IsNewThread(), "Function %s should have been threaded off", FUNC_NAME() )
	mAssert( file.bLiveMetricsOnlyForNonCombatMode, "Method only valid in non combat modes. Enable with Tracker_RegisterTrackingAsNonCombatMode( true )" )
	mAssert( updateInterval >= MIN_INTERVAL_BACKEND_UPDATES, "Cannot update stats sooner than every %.0f seconds", MIN_INTERVAL_BACKEND_UPDATES )

	OnThreadEnd
	(
		void function()
		{
			sqprint( "UpdateMetricsAtInterval Shutting down..." )
		}
	)

	svGlobal.levelEnt.EndSignal( "GameEnd" )

	for( ; ; )
	{
		wait updateInterval
		__UpdateLiveStats_internal( Tracker_BuildAllPlayerMetrics( true ) )
		__DestroyStats()
	}
}

void function Tracker_UpdateAtInterval( float updateInterval )
{
	mAssert( !file.bUpdateIntervalThreadRunning, "%s was already running", FUNC_NAME() )
	mAssert( file.bLiveMetricsOnlyForNonCombatMode, "Method only valid in non combat modes. Enable with Tracker_RegisterTrackingAsNonCombatMode( true )" )
	mAssert( updateInterval >= MIN_INTERVAL_BACKEND_UPDATES, "Cannot update stats sooner than every %d seconds", MIN_INTERVAL_BACKEND_UPDATES )

	file.bUpdateIntervalThreadRunning = true
	thread __UpdateMetricsAtInterval( updateInterval )
}

void function PIN_GameEnd()
{
	if ( process_end_round_complete == true )
	{
		svGlobal.levelEnt.Signal( "KillIntervalThread" )
		thread FinishGameStatsRound()
	}
}

void function PIN_AddPlayer( entity player )
{
	if( !IsValid( player ) )
		return

	if( !file.global_stats || !bLog() )
		SetStatsReadyFlag( player, true )

	if( GetPlayerLeftFlag( player ) )
	{
		//sqprint("R5RDEV_DEBUG_PRINT: Player had left previously flag triggered")
		UpdateFromLocalPersistence( player )
	}
	else
	{
		if( !Tracker_IsStatsReadyFor( player ) )
		{
			waitthread WaitSignalOrTimeout( player, 15, "SyncDataFullyLoaded", "OnDestroy", "OnDisconnected" )

			if( !IsValid( player ) )
				return
		}

		if( Flowstate_IsLGDuels() )
			ResetLoadedWeapons( player )
	}

	if( file.restricted_server )
		thread CheckForPlayerAccess( player )

	if( file.bTrackerEnabled && TrackerIsLogging__internal() && IsValid( player ) )
	{
		TrackerLogEvent__internal
		(
			format
			(
				"^^,%s,0,%s,%d,,,,%i,,,,,%s\n",
				player.GetPlatformUID(),
				GetNumTeamsRemaining().tostring(),
				GetUnixTimestamp(),
				Tracker_DecideTimeRemaining(),
				player.GetPlayerName()
			),

			file.bTrackerEncryption
		)
	}
}

void function PIN_PlayerLeft( entity player, string reason )
{
	if( !IsValid_ThisFrame( player ) )
		return

	string playerName = player.GetPlayerName()
	string OID = player.GetPlatformUID()

	PIN_PlayerLeftSnapshot( OID, playerName, reason )
}

void function PIN_PlayerLeftSnapshot( string OID, string playerName, string reason )
{
	//string message = format("%s disconnected ", pname )
	//sqprint(message)

	if( OID == "" )
		return

	if ( file.bTrackerEnabled && file.bSafeLog )
	{
		if ( TrackerIsLogging__internal() )
		{
			if ( file.update_discord_player_counts )
			{
				string count = ( GetNumHumanPlayers() - 1 ).tostring()
				PlayerCounts( "Left", playerName, OID, count )
			}

			TrackerLogEvent__internal
			(
				format
				(
					"|&,%s,%i,%d,%s",
					OID,
					Tracker_DecideTimeRemaining(),
					GetUnixTimestamp(),
					playerName
					),

				file.bTrackerEncryption
			)
		}
	}
}

