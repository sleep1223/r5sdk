int function CheckIfPlayerHasAccess( entity player )
{
	string player_UID = player.GetPlatformUID()

	if ( GetAdminList().contains( player_UID ) )
		return 7

	if ( file.whitelist.contains( player_UID ) )
		return 8

	if( file.restricted_whitelist_only )
		return -1

	if ( player.p.season_score < Tracker_GetQueryInt( "restricted_rank" ) )
		return 6

	if ( player.p.season_gamesplayed < file.restricted_gamesplayed )
		return 4

	if ( player.p.season_kills < file.restricted_kills )
		return 3

	if ( getkd( player.p.season_kills, player.p.season_deaths ) < file.restricted_kd )
		return 2

	if ( player.p.season_playtime < file.restricted_playtime )
		return 1

	return 9
}

string function GetPlayerAccessMessage( entity player, int result )
{
	switch( result )
	{
		case 9:
			return LineBreak( ResolveFormattersForPlayerMessage( player, file.restricted_join_message ) )

		case 8:
			return LineBreak( ResolveFormattersForPlayerMessage( player, file.restricted_whitelist_message ) )

		case 7:
			return LineBreak( ResolveFormattersForPlayerMessage( player, file.restricted_admin_message ) )

		case 6:
			return "Your Rank is too low to play on this server. \n\n Your Score: " + player.p.season_score.tostring() + ". \nLowest rank allowed: " + file.restricted_rank.tostring() + " (Score: " + Tracker_GetQueryInt( "restricted_rank" ).tostring() + ")" //this Tracker_GetQueryInt() setting should be named restricted_score for clarity

		case 4:
			return "You do not have enough games played to play on this server. \n Your total games played: " + player.p.season_gamesplayed.tostring() + " \n Server required minimum: " + file.restricted_gamesplayed.tostring() + "\n You need to play " + ( file.restricted_gamesplayed - player.p.season_gamesplayed ).tostring() + " more games to play on this server."

		case 3:
			return "You do not have enough kills to play on this server. \n Your kills: " + player.p.season_kills.tostring() + " \n Server required minimum: " + file.restricted_kills.tostring() + "\n You need " + ( file.restricted_kills - player.p.season_kills ).tostring() + " more kills to play on this server."

		case 2:
			return "Your K/D ratio is too low to play on this server. \n Your K/D: " + getkd( player.p.season_kills, player.p.season_deaths ) + " \n Server required minimum: " + file.restricted_kd.tostring() + "\n You need to increase your K/D ratio by:  " + ( file.restricted_kd - getkd( player.p.season_kills, player.p.season_deaths )).tostring() + " to play on this server."

		case 1:
			return "Your play time does not meet this server's required minimum play time of: " + PlayTimeFromSecondsString( file.restricted_playtime ) + "\n Your playtime: " + PlayTimeFromSecondsString( player.p.season_playtime ) + "\n\n You need to play for at least: " + PlayTimeFromSecondsString( ( file.restricted_playtime - player.p.season_playtime) ) + " more time."

		case -1:
			return "This server has Private mode enabled. Please contact the admin to be added to the whitelist."

		default:
			return "Error 404"
	}

	unreachable
}

void function force_rest( entity player )
{
	EndSignal( player, "OnDisconnected", "OnDestroy" )

	while( IsValid( player ) )
	{
		player.FreezeControlsOnServer()
		player.ForceStand()
		Gamemode1v1_ForceRest( player )
		wait 0.5
	}
}

void function CheckForPlayerAccess( entity player )
{
	if( !IsValid( player ) )
		return

	EndSignal( player, "OnDisconnected", "OnDestroy" )
	CommandsEnabled( player, false )

	if( Gamemode() == eGamemodes.SURVIVAL || Playlist() == ePlaylists.fs_scenarios )
	{
		wait 1 //allow setup callbacks to run

		if( !IsValid( player ) )
			return
	}

	Gamemode1v1_ForceRest( player )

	if( !GetServerVar( "batch_fetch_complete" ) )
	{
		WaitSignal( tracker.signalEnt, "BatchFetchComplete" )

		if( !IsValid( player ) )
			return
	}

	if( !Tracker_IsStatsReadyFor( player ) )
	{
		WaitSignal( player, "SyncDataFullyLoaded" )

		if( !IsValid( player ) )
			return
	}

	//this int must be set after stats have loaded
	int access_status = CheckIfPlayerHasAccess( player )

	wait 2

	if( !IsValid( player ) )
		return

	if ( access_status >= RESTRICTED_ACCESS_STATUS_REQUIRED )//Todo: Revisit for more modularity from a single defined source and remove CONST adjustments
	{
		Gamemode1v1_ForceRest( player )
		Message( player, "Welcome " + player.GetPlayerName(),  GetPlayerAccessMessage( player, access_status ), 30 )
		CommandsEnabled( player, true )
	}
	else
	{
		thread force_rest( player )

		Message( player, "Sorry " + player.GetPlayerName(),  GetPlayerAccessMessage( player, access_status ), 30 )
		wait 7

		if( !IsValid( player ) )
			return

		KickPlayerById( player.GetPlatformUID(), GetPlayerAccessMessage( player, access_status ) )
		UpdatePlayerCounts()

		if( file.bRestrictedKickLog )
			sqprint( format( "\n\n Player: %s, Kick msg: %s", player.GetPlayerName(), GetPlayerAccessMessage( player, access_status ) ) )
	}
}

const array<string> SERVER_MSG_EVENT_TYPES =
[
	"start",
	"end",
	"join"
]

void function BroadcastIntervalMessagesInit()
{
	file.MessageEvents.clear()
	file.Messages_EventStart.clear()
	file.Messages_EventEnd.clear()
	file.Messages_EventJoin.clear()

	ParseRules rules
	rules.escapeChar = "\\"
	rules.escapeMap =
	{
		["\\"] = "\\",
		["|"] = "|",
		["="] = "="
	}

	bool gotoLoopMessage = false

	string msg_ArrayString = strip( TrackerGetSettingString( "settings.INTERVAL_MESSAGES" ) )
	if( msg_ArrayString.len() == 0 )
		gotoLoopMessage = true

	if ( !gotoLoopMessage )
	{
		array<string> interval_settings = SplitUnescapedWithRules( msg_ArrayString, "|", rules )

		int iMessageNum = 0

		foreach ( msg_string in interval_settings )
		{
			iMessageNum++

			string stripped = strip( msg_string )
			int eqIndex = FindFirstUnescaped( stripped, "=", rules )

			if ( eqIndex == -1 )
				continue

			string sM0 = strip( stripped.slice( 0, eqIndex ) )
			string sM1 = strip( stripped.slice( eqIndex + 1 ) )

			sM0 = UnescapeWithRules( sM0, rules )
			sM1 = UnescapeWithRules( sM1, rules )

			#if DEVELOPER
				sqprint( format( "interval found: %s  ;message: %s", sM0, sM1 ) )
			#endif

			string sm0Match = sM0.tolower()

			if ( IsStringNumeric( sM0, 0, file.flowstateRoundtime ) && sM1.len() > 0 && sM1.len() < 1000 )
			{
				try
				{
					string sMsg = StringRemoveControlCharacters( sM1 )

					int convert = sM0.tointeger()
					float iRound10 = ceil( float( convert ) / 10.0 ) * 10
					int interval = ( iRound10 / 10 ).tointeger()

					if ( !( interval in file.MessageEvents ) )
					{
						array<string> messages
						messages.append( sMsg )
						file.MessageEvents[ interval ] <- messages
					}
					else
					{
						file.MessageEvents[ interval ].append( sMsg )
					}
				}
				catch ( c_err )
				{
					sqerror( format( "Cannot add msg #[ %d ] to MessageEvents, improper format", iMessageNum ) )
				}
			}
			else if ( SERVER_MSG_EVENT_TYPES.contains( sm0Match ) && sM1.len() > 0 && sM1.len() < 1000 )
			{
				switch ( sm0Match )
				{
					case "start":
						file.Messages_EventStart.append( sM1 )
						break
					case "end":
						file.Messages_EventEnd.append( sM1 )
						break
					case "join":
						file.Messages_EventJoin.append( sM1 )
						break
				}
			}
			else
			{
				sqerror( format( "InitIntervalMessages parsing error with: %s, %s", sM0, sM1 ) )
			}
		}

		if ( file.Messages_EventJoin.len() )
			AddCallback_OnClientConnected( BroadcastPersonalMessage )
	}// if !goto

	//loop messages (every x seconds)

	string loopTime = TrackerGetSettingString( "settings.LOOP_MESSAGES_INTERVAL" )

	if( !empty( loopTime ) && IsStringNumeric( loopTime ) )
	{
		int convert = loopTime.tointeger()
		float iRound10 = ceil( float( convert ) / 10.0 ) * 10
		int interval = ( iRound10 / 10 ).tointeger()
		file.iBotMessagesLoopTime = interval //seconds rounded to thread cycle as multiple of 10
	}
	else
	{
		if( !empty( loopTime ) )
			sqerror( "[TRACKER] Invalid LOOP_MESSAGES_INTERVAL ; setting to 60" )

		file.iBotMessagesLoopTime = 6 //60 seconds default
	}

	#if DEVELOPER
		sqprint( format( "file.iBotMessagesLoopTime is: %d ", file.iBotMessagesLoopTime ) )
	#endif

	string getLoopMessages = TrackerGetSettingString( "settings.LOOP_MESSAGES" )

	if ( !empty( getLoopMessages ) )
	{
		array<string> arrLoopMessages = SplitUnescapedWithRules( getLoopMessages, "|", rules )

		foreach ( message in arrLoopMessages )
		{
			string msg = strip( UnescapeWithRules( message, rules ) )

			if ( msg.len() == 0 )
				continue

			file.arrayLoopMessages.append( msg )

			#if DEVELOPER
				sqprint( format( "Initialized loop message: %s", message ) )
			#endif
		}
	}

	thread MessageIntervalThread()
}

void function __executeEventStart_messages()
{
	if( file.Messages_EventStart.len() == 0 )
		return

	foreach ( message in file.Messages_EventStart )
		SendServerMessage( message )
}

void function __executeEventEnd_messages()
{
	if( file.Messages_EventEnd.len() == 0 )
		return

	foreach ( message in file.Messages_EventEnd )
		SendServerMessage( message )
}

void function BroadcastPersonalMessage( entity player )
{
	if( !IsValid( player ) )
		return

	if( bGlobalStats() )
		thread __BroadcastPersonalMessage( player )
	else
		__BroadcastPersonalMessage( player )
}

void function __BroadcastPersonalMessage( entity player )
{
	if( !IsValid( player ) )
		return

	if( IsNewThread() )
	{
		if( !Tracker_IsStatsReadyFor( player ) )
		{
			player.EndSignal( "OnDestroy", "OnDisconnected" )
			waitthread WaitSignalOrTimeout( player, 15.0, "SyncDataFullyLoaded" )

			if( !IsValid( player ) )
				return
		}
	}

	if( !IsValid( player ) )
		return

	foreach( int index, string message in file.Messages_EventJoin )
	{
		message = ResolveFormattersForPlayerMessage( player, message )
		SendServerMessageToPlayer( player, message )
	}
}

void function DEV_StartIntervalThread()
{
	thread MessageIntervalThread()
}

void function MessageIntervalThread()
{
	int threadCycleCount = 0
	int loopMsgCount = 1 //gets reset when last message in loop messages is reached

	file.bIntervalThreadRunning = true

	Signal( svGlobal.levelEnt, "KillIntervalThread" )
	EndSignal( svGlobal.levelEnt, "KillIntervalThread" )

	bool bLoopServerMessages = true

	if( file.arrayLoopMessages.len() <= 0 )
		bLoopServerMessages = false

	OnThreadEnd
	(
		void function() : ()
		{
			file.bIntervalThreadRunning = false
		}
	)

	for( ; ; )
	{
		wait 10

		threadCycleCount += 1

		//events
		foreach( interval, msgs in file.MessageEvents )
		{
			if ( ( threadCycleCount % interval ) == 0 )
			{
				foreach( index, _msg in msgs )
					SendServerMessage( _msg )
			}
		}

		//train (loopmessages)
		if( bLoopServerMessages && threadCycleCount > 0 )
			loopMsgCount = SendLoopMessage( threadCycleCount, loopMsgCount )
	}

	file.bIntervalThreadRunning = false
}

bool function IsMessageBotIntervalThreadRunning()
{
	return file.bIntervalThreadRunning
}

int function SendLoopMessage( int threadCycleCount, int loopMsgCount  )
{
	if( loopMsgCount > file.arrayLoopMessages.len() )
		loopMsgCount = 1

	if( loopMsgCount > 0 && threadCycleCount > 0 && threadCycleCount % file.iBotMessagesLoopTime == 0  )
	{
		SendServerMessage( file.arrayLoopMessages[( loopMsgCount - 1 )] )
		loopMsgCount++
	}

	return loopMsgCount
}

