//									//
//		  PLAYER METRICS INIT		//
//									//
//////////////////////////////////////


int function GetPlayerMetricsIndex( entity player )
{
	if( !IsValid( player ) )
		return -1

	string uid = player.GetPlatformUID()
	if( uid == "" )
		return -1

    if ( uid in file.PlayerIdMap )
	{
		int index = file.PlayerIdMap[ uid ]
		if( index >= 0 && index < file.PlayerMetricsArray.len() )
			return index

		delete file.PlayerIdMap[ uid ]
	}

	return InitializePlayerMetricsStructForPlayer( player )
}

bool function Tracker_IsPlayerMetricsInitialized( string uid )
{
	if( uid == "" || !( uid in file.PlayerIdMap ) )
		return false

	int index = file.PlayerIdMap[ uid ]
	if( index >= 0 && index < file.PlayerMetricsArray.len() )
		return true

	// PlayerMetricsArray is rebuilt between rounds. Never let a stale map entry
	// escape into callers while the two containers are being reset.
	delete file.PlayerIdMap[ uid ]
	return false
}

int function GetPlayerMetricsIndexByUID( string uid )
{
	if( uid == "" )
		return -1

	if ( uid in file.PlayerIdMap )
	{
		int index = file.PlayerIdMap[ uid ]
		if( index >= 0 && index < file.PlayerMetricsArray.len() )
			return index

		delete file.PlayerIdMap[ uid ]
	}

    return InitializePlayerMetricsStructForPlayerByUID( uid )
}

bool function IsValidPlayerMetricsIndex( int index )
{
	return ( index >= 0 && index < file.PlayerMetricsArray.len() )
}

PlayerMetrics function __GetPlayerMetrics( int id )
{
	if( IsValidPlayerMetricsIndex( id ) )
		return file.PlayerMetricsArray[ id ]
	else
	{
		#if DEVELOPER
			mAssert( false, "Tried to return an invalid player metrics id: " + id )
		#endif
	}

	PlayerMetrics metrics
	return metrics
}

#if DEVELOPER
	int function DEV_GetPlayerMetricsIndexByUID( string uid )
	{
		return GetPlayerMetricsIndexByUID( uid )
	}
#endif

int function PlayerMap_Insert( string uid )
{
	if( uid == "" || file.PlayerMetricsArray.len() == 0 )
		return -1

    int index = file.PlayerMetricsArray.len() - 1
	if( !IsValidPlayerMetricsIndex( index ) )
		return -1

	file.PlayerIdMap[ uid ] <- index
	return index
}


int function InitializePlayerMetricsStructForPlayerByUID( string playerID )
{
	entity p
	return InitializePlayerMetricsStructForPlayer( p, playerID )
}


void function RecordPlayerJump( entity player )
{
    int index = GetPlayerMetricsIndex( player )
	if( !IsValidPlayerMetricsIndex( index ) )
		return

    file.PlayerMetricsArray[ index ].JumpTimestamps.append( Time() )
}


void function RecordPlayerSuperglides( entity player )
{
    int index = GetPlayerMetricsIndex( player )
	if( !IsValidPlayerMetricsIndex( index ) )
		return

    file.PlayerMetricsArray[ index ].SuperglideTimestamps.append( Time() )
}


void function RecordPlayerShot( entity player, int weaponSource )
{
    int index = GetPlayerMetricsIndex( player )
	if( !IsValidPlayerMetricsIndex( index ) )
		return

	if ( !( weaponSource in file.PlayerMetricsArray[ index ].WeaponShotsTimestamps ) )
		file.PlayerMetricsArray[ index ].WeaponShotsTimestamps[ weaponSource ] <- [ Time() ]
	else
		file.PlayerMetricsArray[ index ].WeaponShotsTimestamps[ weaponSource ].append( Time() )
}

void function Tracker_NegateWeaponShot( entity player, int weaponSource )
{
	int index = GetPlayerMetricsIndex( player )
	if( !IsValidPlayerMetricsIndex( index ) )
		return

	if ( !( weaponSource in file.PlayerMetricsArray[ index ].WeaponShotsTimestamps ) )
		return

	if( file.PlayerMetricsArray[ index ].WeaponShotsTimestamps[ weaponSource ].len() )
		file.PlayerMetricsArray[ index ].WeaponShotsTimestamps[ weaponSource ].pop()
}

void function DEV_PrintShotTimestamps( entity player )
{
	int index = GetPlayerMetricsIndex( player )
	if( !IsValidPlayerMetricsIndex( index ) )
		return

	foreach( int weaponSource, array<float> timestamps in file.PlayerMetricsArray[ index ].WeaponShotsTimestamps )
	{
		printt( "weaponSource:", weaponSource )
		foreach( float timestamp in file.PlayerMetricsArray[ index ].WeaponShotsTimestamps[ weaponSource ] )
			printt( "timestamp:", timestamp )

		print( "\n\n")
	}
}

void function AddToPlayerKills( string playerID )
{
	int index = GetPlayerMetricsIndexByUID( playerID )
	if( !IsValidPlayerMetricsIndex( index ) )
		return

	file.PlayerMetricsArray[ index ].kills += 1
}


void function AddToPlayerDeaths( entity player )
{
	// if( !player.IsPlayer() )
		// return

	int index = GetPlayerMetricsIndex( player )
	if( !IsValidPlayerMetricsIndex( index ) )
		return

	file.PlayerMetricsArray[ index ].deaths += 1
}


void function AddToPlayerDamage( string playerID, float damage )
{
	int index = GetPlayerMetricsIndexByUID( playerID )
	if( !IsValidPlayerMetricsIndex( index ) )
		return

	file.PlayerMetricsArray[ index ].damage += damage
}

void function AddToPlayerShots( string playerID, int shots )
{
	int index = GetPlayerMetricsIndexByUID( playerID )
	if( !IsValidPlayerMetricsIndex( index ) )
		return

	file.PlayerMetricsArray[ index ].shots += shots
}

void function AddToPlayerHits( string playerID, int hits )
{
	int index = GetPlayerMetricsIndexByUID( playerID )
