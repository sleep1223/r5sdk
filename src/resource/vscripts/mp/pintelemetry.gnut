void function Tracker_SettingsInit()
{
	//todo: cleanup mode related stuff
	file.bTrackerEnabled 							= TrackerGetSettingBool( "server.TRACKER_ENABLED" )
	file.bTrackerEncryption 						= TrackerGetSettingBool( "server.TRACKER_ENCRYPTION" )
	file.bChatbotEnabled							= TrackerGetSettingBool( "settings.ENABLE_CHATBOT" )
	file.bClientCommandAdminEnabled					= GetConVarInt( "sv_onlineAuthEnable" ) == 1 && GetCurrentPlaylistVarBool( "cc_administration", false )
	file.flowstateRoundtime 						= GetCurrentPlaylistVarInt( "flowstateRoundtime", 1800 )
	file.afk_to_rest_enabled 						= GetCurrentPlaylistVarBool( "afk_to_rest_bool", false )
	file.update_discord_player_counts 				= TrackerGetSettingString( "webhooks.PLAYERS_WEBHOOK" ) != ""
	file.stats_discord_webhook_matches_enabled		= TrackerGetSettingString( "webhooks.MATCHES_WEBHOOK" ) != ""
	file.gamemode_type_1v1 							= g_bIs1v1GameType() //returns true if mode is confifugred as 1v1 type

	if( file.bChatbotEnabled )
		file.msgBotPrefix = TrackerGetSettingString( "settings.CHATBOT_PREFIX" )

	//init stat bools (must be before string inits) todo: cleanup
	file.global_stats 						= TrackerGetSettingBool( "server.USE_GLOBAL_STATS" )

	//restricted init
	file.restricted_server 					= TrackerGetSettingBool( "private.RESTRICTED_SERVER" )
	file.restricted_whitelist_only			= TrackerGetSettingBool( "private.RESTRICTED_WHITELIST_ONLY" )

	//messages
	file.restricted_join_message 			= TrackerGetSettingString( "private.RESTRICTED_JOIN_MESSAGE" )
	file.restricted_whitelist_message 		= TrackerGetSettingString( "private.RESTRICTED_WHITELIST_MESSAGE" )
	file.restricted_admin_message 			= TrackerGetSettingString( "private.RESTRICTED_ADMIN_MESSAGE" )

	//vetting vars
	file.restricted_gamesplayed 			= TrackerGetSettingInt( "private.RESTRICTED_GAMESPLAYED" )
	file.restricted_playtime 				= TrackerGetSettingInt( "private.RESTRICTED_PLAYTIME" )
	file.restricted_rank 					= TrackerGetSettingInt( "private.RESTRICTED_RANK" )
	file.restricted_kills 					= TrackerGetSettingInt( "private.RESTRICTED_KILLS" )
	file.restricted_kd 						= TrackerGetSettingFloat( "private.RESTRICTED_KD" )
	file.bRestrictedKickLog					= TrackerGetSettingBool( "private.RESTRICTED_KICK_LOG" )

	//max wait for players to connect before querying batch player stats
	float trackerMaxWait 					= TrackerGetSettingFloat( "server.TRACKER_MAX_WAIT" )
	file.maxWaitForBatchLoad				= trackerMaxWait > 0.0 ? trackerMaxWait : 7.0
}

//initplayer
void function PlayerConnectedCallback( entity player )
{
	if ( IsLobby() )
		return

	if ( !IsValid( player ) )
		return

	//init player vars
	int playerHandle = player.GetEncodedEHandle()
	string playerUID = player.GetPlatformUID()
	string playerName = player.GetPlayerName()

	player.p.name = playerName
	player.p.UID = playerUID
	player.p.handle = playerHandle
	//sqprint(format("Added handle as: %d,  saved state: %d", playerHandle, player.p.handle ))

	string uid = player.GetPlatformUID()
	int mID = InitializePlayerMetricsStructForPlayer( player )
	if( mID == -1 )
		return

	if( IsValidPlayerMetricsIndex( mID ) )
	{
		file.PlayerMetricsArray[ mID ].ent = player
		file.PlayerMetricsArray[ mID ].playerHandle = playerHandle
	}

	/////////////////////////////////////////////////////////////////////////////////////////
	if( !file.bTrackerEnabled )
		return
	/////////////////////////////////////////////////////////////////////////////////////////

	//init player map
	PlayerData pdata

	pdata.playerName = playerName
	pdata.playerUID = playerUID

	file.HandleToPlayerData[ playerHandle ] <- pdata

    thread PIN_AddPlayer( player )

	if( file.superglideDetect )
	{
		AddPlayerMovementEventCallback( player , ePlayerMovementEvents.JUMP, OnJumped )
		AddPlayerMovementEventCallback( player, ePlayerMovementEvents.MANTLE, Flowstate_TrackingVision_SuperglideDetection_Stats ) //credit cafe
	}

	if ( file.update_discord_player_counts )
	{
		PlayerCounts
		(
			"Connected",
			StringRemoveControlCharacters( pdata.playerName ),
			pdata.playerUID,
			GetNumHumanPlayers().tostring()
		)
	}

	if ( file.global_stats )
	{
		if ( GetServerVar( "batch_fetch_complete" ) )
			__LoadPlayerSyncData( player )

		thread __SetPlayerSyncData( player )
	}
}

void function PlayerCounts( string state, string name, string OID, string count )
{
	bool bIsPlaying
	if( Gamemode() == eGamemodes.fs_dm )
		bIsPlaying = GetGlobalNetInt( "FSDM_GameState" ) == eTDMState.IN_PROGRESS
	else
		bIsPlaying = GamePlaying()

	if ( bIsPlaying || GetNumHumanPlayers() == 1 )
		TrackerUpdatePlayerCount__internal( state, name, OID, count )
}

