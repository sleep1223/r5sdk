void function PIN_PlayerKilled( entity victim, entity attacker, var damageInfo )
{
	if ( !matchReportPinTelemetryKillLogged )
	{
		matchReportPinTelemetryKillLogged = true
		MatchReportWeaponStats_DebugNote( "PIN_PlayerKilled tracker" )
	}
	if ( MatchReportWeaponStats_IsInitialized() )
		MatchReportWeaponStats_RecordPlayerKilled( victim, attacker, damageInfo )

	if ( file.bTrackerEnabled && TrackerIsLogging__internal() && IsValid( victim ) && victim.IsPlayer() && IsValid( attacker ) )
	{
		if( !damageInfo )
			return

		if( attacker.e.stateFlags & STATE_FLAG_NO_STATS )
			return

		if( victim.e.stateFlags & STATE_FLAG_NO_STATS )
			return

		int damageSourceID = DamageInfo_GetDamageSourceIdentifier( damageInfo )
		thread __EndFight( victim, attacker, damageSourceID, Time(), StatPrintVector( attacker.GetOrigin() ), StatPrintVector( victim.GetOrigin() ) )
	}
}

void function Tracker_EndFight( entity victim, entity attacker, var damageInfo )
{
	if( !Flowstate_IsTrackerSupportedMode() || !file.bTrackerEnabled || !TrackerIsLogging__internal() )
		return

	if( !damageInfo || !IsValid( victim ) || !IsValid( attacker ) )
		return

	if( attacker.e.stateFlags & STATE_FLAG_NO_STATS )
		return

	if( victim.e.stateFlags & STATE_FLAG_NO_STATS )
		return

	int damageSourceID = DamageInfo_GetDamageSourceIdentifier( damageInfo )
	thread __EndFight( victim, attacker, damageSourceID, Time(), StatPrintVector( attacker.GetOrigin() ), StatPrintVector( victim.GetOrigin() ) )
}

