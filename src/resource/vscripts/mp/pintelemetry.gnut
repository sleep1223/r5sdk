void function VerifyMessageToken( entity player, string token, string subToken = "#FS_NULL" )
{
	LocalMsg( player, token, subToken, eMsgUI.NOTIFICATION, 10.0 )
}

void function VerifyMessage( entity player, string msgTitle, string msgBody = "" )
{
	LocalMsg( player, "#FS_NULL", "#FS_NULL", eMsgUI.NOTIFICATION, 10.0, "\n" + msgTitle, "\n" + msgBody )
}

//this blows  ( The reason for this madness is to prevent rejoining to bypass attempt throttle )
bool function ClientCommand_TrackerVerifyAccount( entity player, array<string> args )
{
	if( !IsValid( player ) || !player.p.isConnected )
		return true

	if( !CheckRate( player ) )
		return true

	if( player.p.eaVerifyProcessing == true )
		return true
	else
		player.p.eaVerifyProcessing = true

	string ea_acc = player.GetPlayerName()
	string OID = player.GetPlatformUID()

	int index = -1
	for ( int i = 0; i < file.playerVerifyCounts.len(); i++ )
	{
		if ( file.playerVerifyCounts[ i ].playerID == ea_acc )
		{
			index = i
			break
		}
	}

	if ( index == -1 )
	{
		PlayerVerifyCount newEntry
		newEntry.playerID = ea_acc
		newEntry.verifyCount = 0
		file.playerVerifyCounts.append( newEntry )
		index = file.playerVerifyCounts.len() - 1
	}
	else if ( file.playerVerifyCounts[ index ].verifyCount >= 3 )
	{
		VerifyMessage( player, "Too many attempts", "Try again later." )
		player.p.eaVerifyProcessing = false
		return true
	}

	if ( args.len() < 1 || empty( args[ 0 ] ) )
	{
		VerifyMessage( player, "Error", "Token from R5R.DEV is required." )
		player.p.eaVerifyProcessing = false
		return true
	}

	file.playerVerifyCounts[ index ].verifyCount++
	TrackerEAVerify__internal( args[ 0 ], OID, ea_acc )

	return true
}

void function CodeCallback_VerifyEaAccount( string oid, int token )
{
	entity player = GetPlayerEntityByUID( oid )
	if( !IsValid( player ) )
		return

	switch ( token )
	{
		case 10:
			VerifyMessage( player, "Failed: Expired Token", "Please request a new one" )
			break

		case 2:
			VerifyMessage( player, "Invalid token", "Usage: ea_verify   yourtoken" )
			break

		case 4:
			VerifyMessage( player, "Failed", "EA Account already linked." )
			break

		case 1:
			VerifyMessage( player, "SUCCESS", "Your account was successfully verified on R5R.DEV" )
			break

		case 5:
			VerifyMessage( player, "Failed: ", "Database error on success" )
			break

		case 3:
			VerifyMessage( player, "Failed: ", "DB error" )
			break

		case 6:
			VerifyMessage( player, "Failed: ", "Missing Data" )
			break

		case 8:
			VerifyMessage( player, "Failed: ", "CURL Error." )
			break

		case 0:
		default:
			VerifyMessage( player, "Failed", "Could not verify EA Account." )
			break
	}

	player.p.eaVerifyProcessing = false
}

