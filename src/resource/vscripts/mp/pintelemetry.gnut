void function PIN_Init()
{
	#if CLIENT
		return
	#endif

	if( IsLobby() )
		return

	TrackerUtilityInit()
	MatchReportWeaponStats_Init()
	if ( !matchReportPinTelemetryInitLogged )
	{
		matchReportPinTelemetryInitLogged = true
		MatchReportWeaponStats_DebugNote( "PIN_Init stub" )
	}

	file.launchStartUnixTime = GetUnixTimestamp()
	SetServerVar( "batch_fetch_complete", true ) //lets users use chat.

	AddCallback_OnClientConnected( PlayerConnectedCallback )
	file.afk_to_rest_enabled = GetCurrentPlaylistVarBool( "afk_to_rest_bool", false ) //later checked against mode/compatibility settings.

	if ( GetCurrentPlaylistVarBool( "cc_administration", false ) )
	{
		if( GetConVarInt( "sv_onlineAuthEnable" ) != 1 )
		{
			Warning( "Tried to enable cc administration via playlist var 'cc_administration 1', but online auth is disabled. For security purposes, cc_administration is now disabled." )
			return
		}

		file.bClientCommandAdminEnabled = true
		__PlayerAdminsInit()
		AddClientCommandCallback( "cc", ClientCommand_mkos_admin )
		AddCallback_OnClientConnected( CheckAdmin_OnConnect )
	}
}

